# PostgreSQL connection string. Replace with your own local/Neon database credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Frontend and public site URLs.
FRONTEND_ORIGIN="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"
VITE_API_BASE_URL=""
PORT=5000
COOKIE_SAME_SITE=Lax

# Password recovery. Required in production; local development has a development-only secret fallback.
# Generate a strong value with: openssl rand -hex 32
PASSWORD_RESET_SECRET=
# Resend transactional email configuration. Use a sender on a verified domain in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Recalldose <no-reply@example.com>"

# AI provider (server only; never prefix secrets with VITE_).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_PROVIDER_LABEL=Google Gemini
AI_USER_RATE_LIMIT=12

# Study uploads. Use persistent private object storage in production.
UPLOAD_DIR=./uploads
STUDY_DATA_DIR=./study-data

# Optional free-first AI fallback providers.
AI_FALLBACK_1_LABEL=OpenRouter Free
AI_FALLBACK_1_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_1_API_KEY=
AI_FALLBACK_1_MODEL=openrouter/free
AI_FALLBACK_2_LABEL=
AI_FALLBACK_2_BASE_URL=
AI_FALLBACK_2_API_KEY=
AI_FALLBACK_2_MODEL=

# Learner activity calendar for daily streaks (set to the platform's main learner timezone).
ACTIVITY_TIME_ZONE=Africa/Cairo
