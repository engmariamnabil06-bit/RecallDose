# PostgreSQL connection string (Neon or local Postgres).
# Example shape only — replace with your own credentials.
DATABASE_URL="postgresql://neondb_owner:npg_ax1TsfYIAeU7@ep-calm-mouse-b4yeh6z4-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Frontend origin allowed to send credentialed API requests.
FRONTEND_ORIGIN="http://localhost:5173"

# Frontend API base URL. Leave empty for same-origin production API; local dev defaults to port 5000.
VITE_API_BASE_URL=""

# API server port (platforms such as Render/Railway provide this automatically).
PORT=5000

# Use "None" only when the frontend and API are on different sites; requires HTTPS.
# SameSite=None cookies require additional CSRF/origin protection before production launch.
COOKIE_SAME_SITE=Lax

# AI provider (server only; NEVER prefix these with VITE_)
# Google AI Studio OpenAI-compatible endpoint is the default.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_PROVIDER_LABEL=Google Gemini
AI_USER_RATE_LIMIT=12


# Study file uploads (use persistent private storage in production)
UPLOAD_DIR=./uploads
STUDY_DATA_DIR=./study-data

# Optional free-first AI fallback providers (used if the primary provider is unavailable).
# Example: OpenRouter free model. Free model availability and limits can change.
AI_FALLBACK_1_LABEL=OpenRouter Free
AI_FALLBACK_1_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_1_API_KEY=
AI_FALLBACK_1_MODEL=openrouter/free

# Optional second fallback (any OpenAI-compatible API).
AI_FALLBACK_2_LABEL=
AI_FALLBACK_2_BASE_URL=
AI_FALLBACK_2_API_KEY=
AI_FALLBACK_2_MODEL=
